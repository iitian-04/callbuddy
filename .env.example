# Copy this file to .env and fill in your own values. .env is gitignored.
# Never paste keys into chat or commit them.

# Required (Phase 1)
GROQ_API_KEY=

# Optional: speech-to-text. With a Deepgram key, STT uses Deepgram; without one it
# uses Groq's Whisper with GROQ_API_KEY. STT_PROVIDER=auto|deepgram|groq
DEEPGRAM_API_KEY=
STT_PROVIDER=auto

# Optional (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
KOKORO_VOICE=af_heart
LOG_LEVEL=INFO
# Phase 2: name the agent calls on behalf of (used when the task doesn't say)
CALLER_NAME=
